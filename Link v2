function hexBytes(hex) {
  const out = new Uint8Array(hex.length / 2);
  for (let i = 0; i < out.length; i++) out[i] = parseInt(hex.slice(i * 2, i * 2 + 2), 16);
  return out;
}

async function verifyDiscordRequest(req, rawBody, env) {
  const signature = req.headers.get("X-Signature-Ed25519") || "";
  const timestamp = req.headers.get("X-Signature-Timestamp") || "";
  if (!signature || !timestamp || !env.DISCORD_PUBLIC_KEY) return false;
  try {
    const publicKey = await crypto.subtle.importKey(
      "raw", hexBytes(env.DISCORD_PUBLIC_KEY), { name: "Ed25519" }, false, ["verify"]
    );
    return await crypto.subtle.verify(
      "Ed25519", publicKey, hexBytes(signature),
      new TextEncoder().encode(timestamp + rawBody)
    );
  } catch (e) {
    return false;
  }
}

function interactionUser(data) {
  return (data.member && data.member.user) || data.user || {};
}

function interactionOption(options, name) {
  for (const option of options || []) {
    if (option.name === name) return option;
    const nested = interactionOption(option.options, name);
    if (nested) return nested;
  }
  return null;
}

function canManageGuild(data) {
  try {
    const permissions = BigInt(data.member?.permissions || "0");
    return (permissions & 0x8n) !== 0n || (permissions & 0x20n) !== 0n;
  } catch (e) {
    return false;
  }
}

async function canUseBotCommands(data, env, guildId) {
  const adminRole = await env.REQS.get("discord:admin-role:" + guildId);
  if (!adminRole) return canManageGuild(data);
  return (data.member?.roles || []).includes(adminRole);
}

async function assignDiscordRole(env, guildId, userId, roleId) {
  const botToken = env.DISCORD_BOT_TOKEN || await env.REQS.get("discord:bot-token");
  if (!botToken) return false;
  const response = await fetch(`https://discord.com/api/v10/guilds/${encodeURIComponent(guildId)}/members/${encodeURIComponent(userId)}/roles/${encodeURIComponent(roleId)}`, {
    method: "PUT",
    headers: { Authorization: "Bot " + botToken }
  });
  return response.ok;
}

async function removeDiscordRole(env, guildId, userId, roleId) {
  const botToken = env.DISCORD_BOT_TOKEN || await env.REQS.get("discord:bot-token");
  if (!botToken) return false;
  const response = await fetch(`https://discord.com/api/v10/guilds/${encodeURIComponent(guildId)}/members/${encodeURIComponent(userId)}/roles/${encodeURIComponent(roleId)}`, {
    method: "DELETE",
    headers: { Authorization: "Bot " + botToken }
  });
  return response.ok;
}

function ephemeral(content) {
  return { type: 4, data: { content, flags: 64, allowed_mentions: { parse: [] } } };
}

function publicReply(content) {
  return { type: 4, data: { content, allowed_mentions: { parse: [] } } };
}

async function handleDiscordInteraction(req, env, url) {
  const rawBody = await req.text();
  if (!await verifyDiscordRequest(req, rawBody, env)) return new Response("Invalid signature", { status: 401 });
  const data = JSON.parse(rawBody);
  if (data.type === 1) return new Response(JSON.stringify({ type: 1 }), { headers: { "Content-Type": "application/json" } });

  const user = interactionUser(data);
  const guildId = data.guild_id || "";
  if (!guildId) return new Response(JSON.stringify(ephemeral("Este comando solo funciona dentro de un servidor.")), { headers: { "Content-Type": "application/json" } });

  if (data.type === 2 && data.data?.name === "generate") {
    if (!await canUseBotCommands(data, env, guildId)) {
      return new Response(JSON.stringify(ephemeral("Solo el rol ADMIN ROLE puede generar keys.")), { headers: { "Content-Type": "application/json" } });
    }
    const duration = data.data.options?.find(o => o.type === 1 && o.name === "key")?.options?.find(o => o.name === "duration")?.value || "";
    const seconds = parseDuration(duration);
    if (!seconds) {
      return new Response(JSON.stringify(ephemeral("Duración inválida. Usa mínimo 60s, por ejemplo: 60s, 1h, 12h, 1d o 1w. El máximo es 30 días.")), { headers: { "Content-Type": "application/json" } });
    }
    const redeem = await issueRedeemKey(env, seconds);
    return new Response(JSON.stringify(ephemeral(redeem.key)), { headers: { "Content-Type": "application/json" } });
  }

  if (data.type === 2 && data.data?.name === "admin") {
    if (!await canUseBotCommands(data, env, guildId)) {
      return new Response(JSON.stringify(ephemeral("Solo el rol ADMIN ROLE puede usar los comandos del bot.")), { headers: { "Content-Type": "application/json" } });
    }
    const subcommand = data.data.options?.find(o => o.type === 1 && o.name === "role");
    const roleId = subcommand?.options?.find(o => o.type === 8)?.value || "";
    if (!roleId) return new Response(JSON.stringify(ephemeral("Uso: /admin role @rol")), { headers: { "Content-Type": "application/json" } });
    await env.REQS.put("discord:admin-role:" + guildId, roleId);
    return new Response(JSON.stringify(ephemeral("ADMIN ROLE guardado. Solo los usuarios con ese rol podrán usar los comandos del bot.")), { headers: { "Content-Type": "application/json" } });
  }

  if (data.type === 2 && data.data?.name === "whitelist") {
    if (!await canUseBotCommands(data, env, guildId)) {
      return new Response(JSON.stringify(ephemeral("Solo el rol ADMIN ROLE puede modificar la whitelist.")), { headers: { "Content-Type": "application/json" } });
    }
    const userId = data.data.options?.find(o => o.name === "user")?.value || "";
    const duration = data.data.options?.find(o => o.name === "duration")?.value || "";
    const seconds = parseDuration(duration);
    if (!userId || !seconds) return new Response(JSON.stringify(ephemeral("Uso: /whitelist @usuario duration:7d. La duración mínima es 60s.")), { headers: { "Content-Type": "application/json" } });
    const expiresAt = Date.now() + seconds * 1000;
    await env.REQS.delete("discord:revoked:" + guildId + ":" + userId);
    await env.REQS.put("discord:white-list:" + guildId + ":" + userId, "1", { expirationTtl: seconds });
    await env.REQS.put("discord:access:" + guildId + ":" + userId, JSON.stringify({ expiresAt }));
    const buyerRole = await env.REQS.get("discord:buyer-role:" + guildId);
    if (!buyerRole) {
      return new Response(JSON.stringify(ephemeral("Usuario agregado a la whitelist durante " + formatDuration(seconds) + ", pero primero configura el rol con /buyer role @rol para asignarlo automáticamente.")), { headers: { "Content-Type": "application/json" } });
    }
    const assigned = await assignDiscordRole(env, guildId, userId, buyerRole);
    const message = assigned
      ? "Usuario agregado a la whitelist durante " + formatDuration(seconds) + " y rol Buyer asignado automáticamente."
      : "Usuario agregado a la whitelist durante " + formatDuration(seconds) + ", pero no pude asignar el rol Buyer. Verifica que el bot tenga Manage Roles y que su rol esté por encima del rol Buyer.";
    return new Response(JSON.stringify(ephemeral(message)), { headers: { "Content-Type": "application/json" } });
  }

  if (data.type === 2 && data.data?.name === "unwhitelist") {
    if (!await canUseBotCommands(data, env, guildId)) {
      return new Response(JSON.stringify(ephemeral("Solo el rol ADMIN ROLE puede quitar usuarios de la whitelist.")), { headers: { "Content-Type": "application/json" } });
    }
    const userId = data.data.options?.find(o => o.name === "user")?.value || "";
    if (!userId) return new Response(JSON.stringify(ephemeral("Uso: /unwhitelist @usuario")), { headers: { "Content-Type": "application/json" } });
    await env.REQS.delete("discord:white-list:" + guildId + ":" + userId);
    await env.REQS.delete("discord:access:" + guildId + ":" + userId);
    await env.REQS.put("discord:revoked:" + guildId + ":" + userId, "1");
    const buyerRole = await env.REQS.get("discord:buyer-role:" + guildId);
    const removed = buyerRole && await removeDiscordRole(env, guildId, userId, buyerRole);
    const message = !buyerRole || removed
      ? "Usuario eliminado de la whitelist, tiempo restante cancelado y rol Buyer retirado."
      : "Usuario eliminado de la whitelist y tiempo restante cancelado, pero no pude retirar el rol Buyer. Verifica los permisos del bot.";
    return new Response(JSON.stringify(ephemeral(message)), { headers: { "Content-Type": "application/json" } });
  }

  if (data.type === 2 && data.data?.name === "panel") {
    if (!await canUseBotCommands(data, env, guildId)) return new Response(JSON.stringify(ephemeral("Solo el rol ADMIN ROLE puede usar los comandos del bot.")), { headers: { "Content-Type": "application/json" } });
    return new Response(JSON.stringify({
      type: 4,
      data: {
        content: "```\nPulsa el botón para solicitar el script. Solo podrán usarlo los usuarios con el rol autorizado.\n```",
        components: [{ type: 1, components: [
          { type: 2, style: 1, label: "GET SCRIPT", custom_id: "zyox:get-script" },
          { type: 2, style: 3, label: "Redeem Key", custom_id: "zyox:redeem-key" },
          { type: 2, style: 1, label: "STATUS", custom_id: "zyox:status" }
        ] }],
        allowed_mentions: { parse: [] }
      }
    }), { headers: { "Content-Type": "application/json" } });
  }

  if (data.type === 2 && data.data?.name === "buyer") {
    if (!await canUseBotCommands(data, env, guildId)) return new Response(JSON.stringify(ephemeral("Solo el rol ADMIN ROLE puede usar los comandos del bot.")), { headers: { "Content-Type": "application/json" } });
    const subcommand = data.data.options?.find(o => o.type === 1 && o.name === "role");
    const roleId = subcommand?.options?.find(o => o.type === 8)?.value || "";
    if (!roleId) return new Response(JSON.stringify(ephemeral("Uso: /buyer role @rol")), { headers: { "Content-Type": "application/json" } });
    await env.REQS.put("discord:buyer-role:" + guildId, roleId);
    return new Response(JSON.stringify(ephemeral("Rol autorizado guardado. Solo los usuarios con ese rol podrán usar GET SCRIPT.")), { headers: { "Content-Type": "application/json" } });
  }

  if (data.type === 2 && data.data?.name === "time") {
    if (!await canUseBotCommands(data, env, guildId)) return new Response(JSON.stringify(ephemeral("Solo el rol ADMIN ROLE puede usar los comandos del bot.")), { headers: { "Content-Type": "application/json" } });
    const duration = data.data.options?.find(o => o.name === "duration")?.value || "";
    const seconds = parseDuration(duration);
    if (!seconds) return new Response(JSON.stringify(ephemeral("Formato inválido. Usa mínimo 60s, por ejemplo: 60s, 1h, 1d o 1w. El máximo es 30d.")), { headers: { "Content-Type": "application/json" } });
    await env.REQS.put("discord:key-ttl:" + guildId, String(seconds));
    return new Response(JSON.stringify(ephemeral(`Duración configurada: ${formatDuration(seconds)}. Se aplicará a las próximas keys.`)), { headers: { "Content-Type": "application/json" } });
  }

  if (data.type === 3 && data.data?.custom_id === "zyox:redeem-key") {
    return new Response(JSON.stringify({
      type: 9,
      data: {
        custom_id: "zyox:redeem-key-modal",
        title: "Redeem Key",
        components: [{ type: 1, components: [{
          type: 4,
          custom_id: "key",
          label: "Escribe tu key",
