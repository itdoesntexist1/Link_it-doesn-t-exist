    const access = accessRaw ? JSON.parse(accessRaw) : null;
    const accessTtl = access?.expiresAt
      ? Math.max(1, Math.ceil((access.expiresAt - Date.now()) / 1000))
      : configuredTtl;
    const session = await issueKey(env, "discord:" + guildId + ":" + (user.id || "unknown"), "STEAL A BRAINROT", accessTtl);
    const loader = 'script_key="' + session.key + '"; script_base_url="' + url.origin + '";\nloadstring(game:HttpGet("' + url.origin + '/payload?key="..script_key))()';
    return new Response(JSON.stringify({
      type: 4,
      data: {
        content: "```lua\n" + loader + "\n```",
        flags: 64,
        allowed_mentions: { parse: [] }
      }
    }), { headers: { "Content-Type": "application/json" } });
  }

  return new Response(JSON.stringify(ephemeral("Comando no reconocido.")), { headers: { "Content-Type": "application/json" } });
}

export default {
  async fetch(req, env) {
    const url = new URL(req.url);
    if (req.method === "OPTIONS") return new Response(null, { headers: cors });

    if (url.pathname === "/discord/setup" && req.method === "GET") {
      return new Response(`<!doctype html><meta name="viewport" content="width=device-width,initial-scale=1"><style>body{font-family:system-ui;background:#08080a;color:#f5f5f8;padding:24px;max-width:560px;margin:auto}input,button{display:block;width:100%;padding:13px;margin:10px 0;border-radius:10px;border:1px solid #333;background:#17171d;color:#fff;font-size:16px}button{background:#f5f5f8;color:#08080a;font-weight:700}#msg{white-space:pre-wrap;margin-top:14px}</style><h1>ZYOXPROTECT</h1><p>Registro de comandos de Discord. El token se guarda de forma privada para poder asignar roles automáticamente.</p><form id="f"><input id="setupToken" type="password" placeholder="Setup token" required><input id="botToken" type="password" placeholder="Bot token" required><input id="applicationId" placeholder="Application ID" required><input id="guildId" placeholder="Server ID" required><button>Registrar comandos</button></form><div id="msg"></div><script>f.onsubmit=async e=>{e.preventDefault();msg.textContent='Registrando...';const r=await fetch('/discord/register',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({setupToken:setupToken.value,botToken:botToken.value,applicationId:applicationId.value,guildId:guildId.value})});msg.textContent=await r.text()}</script>`, { headers: { "Content-Type": "text/html; charset=utf-8", ...cors } });
    }

    if (url.pathname === "/discord/register" && req.method === "POST") {
      const { setupToken, botToken, applicationId, guildId } = await req.json().catch(() => ({}));
      if (!env.DISCORD_SETUP_TOKEN || setupToken !== env.DISCORD_SETUP_TOKEN) return json({ error: "setup_token_invalido" }, 403);
      if (!botToken || !applicationId || !guildId) return json({ error: "faltan_datos" }, 400);
      await env.REQS.put("discord:bot-token", botToken);
      const commands = [
        { name: "generate", description: "Genera una key privada para Redeem Key", options: [{ type: 1, name: "key", description: "Genera una key de acceso", options: [{ type: 3, name: "duration", description: "Mínimo 60s. Ejemplos: 60s, 1h, 1d o 1w", required: true }] }] },
        { name: "admin", description: "Configura el rol que puede usar los comandos del bot", options: [{ type: 1, name: "role", description: "Elige el rol administrador", options: [{ type: 8, name: "role", description: "Rol administrador" }] }] },
        { name: "whitelist", description: "Da acceso temporal a un usuario", options: [{ type: 6, name: "user", description: "Usuario autorizado", required: true }, { type: 3, name: "duration", description: "Ejemplos: 1h, 1d, 7d o 1w", required: true }] },
        { name: "unwhitelist", description: "Revoca el acceso temporal y el rol Buyer", options: [{ type: 6, name: "user", description: "Usuario al que se quitará el acceso", required: true }] },
        { name: "panel", description: "Publica el panel privado de ZYOXPROTECT" },
        { name: "buyer", description: "Configura el rol autorizado para obtener el script", options: [{ type: 1, name: "role", description: "Elige el rol autorizado", options: [{ type: 8, name: "role", description: "Rol autorizado" }] }] },
        { name: "time", description: "Configura cuánto duran las keys nuevas", options: [{ type: 3, name: "duration", description: "Mínimo 60s. Ejemplos: 60s, 1h, 1d o 1w", required: true }] }
      ];
      const discordResponse = await fetch(`https://discord.com/api/v10/applications/${encodeURIComponent(applicationId)}/guilds/${encodeURIComponent(guildId)}/commands`, {
        method: "PUT",
        headers: { Authorization: "Bot " + botToken, "Content-Type": "application/json" },
        body: JSON.stringify(commands)
      });
      const responseText = await discordResponse.text();
      if (!discordResponse.ok) return json({ error: "discord", status: discordResponse.status, detail: responseText }, 502);
      return json({ ok: true, message: "Comandos registrados correctamente" });
    }

    if (url.pathname === "/discord/interactions" && req.method === "POST") {
      return handleDiscordInteraction(req, env, url);
    }

    if (url.pathname === "/validate" && req.method === "GET") {
      const session = await readKey(env, url.searchParams.get("key") || "");
      if (!session || session.panel !== "STEAL A BRAINROT") return new Response("invalid", { status: 401, headers: { ...cors, "Content-Type": "text/plain; charset=utf-8", "Cache-Control": "no-store" } });
      const guildId = url.searchParams.get("guild") || "";
      const userId = url.searchParams.get("user") || "";
      if (guildId && userId) {
        const revoked = await env.REQS.get("discord:revoked:" + guildId + ":" + userId);
        if (revoked) return new Response("invalid", { status: 401, headers: { ...cors, "Content-Type": "text/plain; charset=utf-8", "Cache-Control": "no-store" } });
        const accessRaw = await env.REQS.get("discord:access:" + guildId + ":" + userId);
        if (accessRaw) {
          const access = JSON.parse(accessRaw);
          if (!access.expiresAt || Date.now() >= access.expiresAt) return new Response("invalid", { status: 401, headers: { ...cors, "Content-Type": "text/plain; charset=utf-8", "Cache-Control": "no-store" } });
        }
      }
      return new Response("ok", { headers: { ...cors, "Content-Type": "text/plain; charset=utf-8", "Cache-Control": "no-store" } });
    }

    if (url.pathname === "/discord/script" && req.method === "GET") {
      const token = url.searchParams.get("token") || "";
      const access = await env.REQS.get("discord:script-token:" + token);
      if (!access) return new Response("Enlace expirado o inválido", { status: 401, headers: cors });
      await env.REQS.delete("discord:script-token:" + token);
      const payload = await env.REQS.get(PAYLOAD_KV_KEY);
      if (!payload) return new Response("Payload no configurado", { status: 503, headers: cors });
      return new Response(payload, { headers: { ...cors, "Content-Type": "text/plain; charset=utf-8", "Cache-Control": "no-store" } });
    }

    // Enviar solicitud de acceso.
    if (url.pathname === "/submit" && req.method === "POST") {
      const { codigo, tipo } = await req.json().catch(() => ({}));
      if (!codigo || typeof codigo !== "string" || codigo.length > 100 || !TIPOS.includes(tipo)) {
        return json({ error: "datos" }, 400);
      }
      const id = crypto.randomUUID();
      await env.REQS.put("r:" + id, JSON.stringify({ status: "pending" }), { expirationTtl: 172800 });
      const sig = await sign(env.SECRET, id);
      const r = await discord(env, {
        embeds: [{
          title: "Nueva solicitud", color: 5793266,
          fields: [
            { name: "Código", value: "```" + codigo.slice(0, 100) + "```" },
            { name: "De qué es", value: tipo }
          ],
          timestamp: new Date().toISOString()
        }],
        components: [{ type: 1, components: [{
          type: 2, style: 5, label: "¿ACEPTAR INGRESO?",
          url: `${url.origin}/approve?id=${id}&sig=${sig}`
        }] }]
      });
      if (!r.ok) return json({ error: "webhook" }, 502);
      return json({ id });
    }

    // Entregar el payload únicamente mientras la key de STEAL A BRAINROT esté vigente.
    if (url.pathname === "/payload" && req.method === "GET") {
      const session = await readKey(env, url.searchParams.get("key") || "");
      if (!session || session.panel !== "STEAL A BRAINROT") {
        return new Response("return", { status: 200, headers: { ...cors, "Content-Type": "text/plain; charset=utf-8", "Cache-Control": "no-store" } });
      }
      const payload = await env.REQS.get(PAYLOAD_KV_KEY);
      if (!payload) return new Response("Payload no configurado", { status: 503, headers: cors });
      const key = url.searchParams.get("key") || "";
      const requestParts = String(session.requestId || "").split(":");
      const sessionGuildId = requestParts[1] || "";
      const sessionUserId = requestParts[2] || "";
      return new Response(activeKeyWatchdogLua(url.origin, key, sessionGuildId, sessionUserId, session.expiresAt) + payload, {
        status: 200,
        headers: { ...cors, "Content-Type": "text/plain; charset=utf-8", "Cache-Control": "no-store" }
      });
    }

    // Consultar estado y recuperar la sesión temporal vigente.
    if (url.pathname === "/status" && req.method === "GET") {
      const id = url.searchParams.get("id") || "";
      const v = await env.REQS.get("r:" + id);
      if (!v) return json({ status: "unknown" });
      const data = JSON.parse(v);
      const result = { status: data.status, panel: data.panel || null };
      if (data.panel && data.accessKey) {
        const session = await readKey(env, data.accessKey);
        if (session) {
          result.key = session.key;
          result.expiresAt = session.expiresAt;
        } else {
          result.keyExpired = true;
        }
      }
      return json(result);
    }

    // Aceptar ingreso desde Discord.
    if (url.pathname === "/approve" && req.method === "GET") {
      const id = url.searchParams.get("id") || "";
      const sig = url.searchParams.get("sig") || "";
      if (sig !== await sign(env.SECRET, id)) return htmlPage("Enlace inválido");
      const v = await env.REQS.get("r:" + id);
      if (!v) return htmlPage("Solicitud expirada o inexistente");
      const data = JSON.parse(v);
      if (data.status === "pending") {
        await env.REQS.put("r:" + id, JSON.stringify({ status: "approved" }), { expirationTtl: 172800 });
      }
      return htmlPage("✅ Acceso concedido");
    }

    // Elegir panel y emitir la primera key temporal.
    if (url.pathname === "/panel" && req.method === "POST") {
      const { id, panel } = await req.json().catch(() => ({}));
      const v = await env.REQS.get("r:" + id);
      if (!v) return json({ error: "no" }, 403);
      const data = JSON.parse(v);
      if (data.status !== "approved" || !PANELES.includes(panel)) return json({ error: "no" }, 403);
      if (data.accessKey) await deleteKey(env, data.accessKey);

      const session = await issueKey(env, id, panel);
      await env.REQS.put("r:" + id, JSON.stringify({
        status: "approved", panel, accessKey: session.key
      }), { expirationTtl: 172800 });

      const sig = await sign(env.SECRET, id);
      await discord(env, {
        embeds: [{ title: "Panel elegido", color: 5793266,
          fields: [{ name: "Panel", value: panel }], timestamp: new Date().toISOString() }],
        components: [{ type: 1, components: [{
          type: 2, style: 5, label: "¿REVOCAR ELECCIÓN?",
          url: `${url.origin}/revoke?id=${id}&sig=${sig}`
        }] }]
      });
      return json({ ok: true, key: session.key, expiresAt: session.expiresAt });
    }

    // Renovar una key: invalida la anterior y entrega una nueva por 60 segundos.
    if (url.pathname === "/renew" && req.method === "POST") {
      const { id, key } = await req.json().catch(() => ({}));
      const oldSession = await readKey(env, key);
      if (!oldSession || oldSession.requestId !== id) return json({ ok: false, error: "key_expirada" }, 401);
      const v = await env.REQS.get("r:" + id);
      if (!v) return json({ ok: false, error: "sesion_inexistente" }, 401);
      const data = JSON.parse(v);
      if (data.status !== "approved" || data.accessKey !== oldSession.key) {
        return json({ ok: false, error: "sesion_revocada" }, 403);
      }
      await deleteKey(env, oldSession.key);
      const session = await issueKey(env, id, oldSession.panel);
      await env.REQS.put("r:" + id, JSON.stringify({ ...data, accessKey: session.key }), { expirationTtl: 172800 });
      return json({ ok: true, key: session.key, expiresAt: session.expiresAt });
    }

    // Cierre controlado al expirar: una sola petición, no una inundación de tráfico.
    if (url.pathname === "/expire" && req.method === "POST") {
      const { id, key } = await req.json().catch(() => ({}));
      const session = await readKey(env, key);
      if (!session || session.requestId !== id) return json({ ok: true });
      await deleteKey(env, session.key);
      const v = await env.REQS.get("r:" + id);
      if (v) {
        const data = JSON.parse(v);
        if (data.accessKey === session.key) {
          await env.REQS.put("r:" + id, JSON.stringify({ ...data, accessKey: null }), { expirationTtl: 172800 });
        }
      }
      return json({ ok: true });
    }

    // Revocar elección desde Discord.
    if (url.pathname === "/revoke" && req.method === "GET") {
      const id = url.searchParams.get("id") || "";
      const sig = url.searchParams.get("sig") || "";
      if (sig !== await sign(env.SECRET, id)) return htmlPage("Enlace inválido");
      const v = await env.REQS.get("r:" + id);
      if (!v) return htmlPage("Solicitud ya no existe");
      const data = JSON.parse(v);
      if (data.accessKey) await deleteKey(env, data.accessKey);
      await env.REQS.delete("r:" + id);
      return htmlPage("✅ Elección revocada. El usuario puede empezar de nuevo.");
    }

    return json({ error: "not found" }, 404);
  }
};
