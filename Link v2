          min_length: 1,
          max_length: 100
        }] }]
      }
    }), { headers: { "Content-Type": "application/json" } });
  }

  if (data.type === 5 && data.data?.custom_id === "zyox:redeem-key-modal") {
    const redeemKey = data.data.components?.flatMap(row => row.components || []).find(component => component.custom_id === "key")?.value || "";
    const redeem = await consumeRedeemKey(env, redeemKey);
    if (!redeem) {
      return new Response(JSON.stringify(ephemeral("La key es inválida, ya fue utilizada o expiró.")), { headers: { "Content-Type": "application/json" } });
    }
    const userId = data.member?.user?.id || data.user?.id || "";
    const remainingSeconds = Math.max(1, Math.ceil((redeem.expiresAt - Date.now()) / 1000));
    await env.REQS.delete("discord:revoked:" + guildId + ":" + userId);
    await env.REQS.put("discord:white-list:" + guildId + ":" + userId, "1", { expirationTtl: remainingSeconds });
