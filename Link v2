function cleanKey(value) {
  return typeof value === "string" && /^[A-Za-z0-9-]{20,100}$/.test(value) ? value : "";
}

function parseDuration(value) {
  const match = String(value || "").trim().toLowerCase().match(/^(\d+)(s|m|h|d|w)$/);
  if (!match) return null;
  const amount = Number(match[1]);
  const units = { s: 1, m: 60, h: 3600, d: 86400, w: 604800 };
  const seconds = amount * units[match[2]];
  if (!Number.isSafeInteger(seconds) || seconds < 60 || seconds > MAX_KEY_TTL) return null;
  return seconds;
}

function formatDuration(seconds) {
  if (seconds % 604800 === 0) return `${seconds / 604800}w`;
  if (seconds % 86400 === 0) return `${seconds / 86400}d`;
  if (seconds % 3600 === 0) return `${seconds / 3600}h`;
  if (seconds % 60 === 0) return `${seconds / 60}m`;
  return `${seconds}s`;
}

async function issueKey(env, requestId, panel, ttl = KEY_TTL) {
  const key = crypto.randomUUID() + "-" + crypto.randomUUID();
  const safeTtl = Math.max(1, Math.min(MAX_KEY_TTL, Math.floor(ttl)));
  const expiresAt = Date.now() + safeTtl * 1000;
  await env.REQS.put("k:" + key, JSON.stringify({ requestId, panel, expiresAt }), {
    expirationTtl: safeTtl
  });
  return { key, expiresAt };
}

async function issueRedeemKey(env, ttl = KEY_TTL) {
  const key = crypto.randomUUID() + "-" + crypto.randomUUID();
  const safeTtl = Math.max(1, Math.min(MAX_KEY_TTL, Math.floor(ttl)));
  const expiresAt = Date.now() + safeTtl * 1000;
  await env.REQS.put("redeem:" + key, JSON.stringify({ expiresAt }), {
    expirationTtl: safeTtl
  });
  return { key, expiresAt };
}

async function consumeRedeemKey(env, key) {
  const safeKey = cleanKey(key);
  if (!safeKey) return false;
  const raw = await env.REQS.get("redeem:" + safeKey);
  if (!raw) return false;
  const data = JSON.parse(raw);
  await env.REQS.delete("redeem:" + safeKey);
  if (!data.expiresAt || Date.now() >= data.expiresAt) return false;
  return data;
}

async function readKey(env, key) {
  const safeKey = cleanKey(key);
  if (!safeKey) return null;
  const raw = await env.REQS.get("k:" + safeKey);
  if (!raw) return null;
  const data = JSON.parse(raw);
  if (!data.expiresAt || Date.now() >= data.expiresAt) {
    await env.REQS.delete("k:" + safeKey);
    return null;
  }
  return { ...data, key: safeKey };
}

async function deleteKey(env, key) {
  const safeKey = cleanKey(key);
  if (safeKey) await env.REQS.delete("k:" + safeKey);
}



